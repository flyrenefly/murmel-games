{
  "name": "murmel-games",
  "version": "0.1.0",
  "description": "Murmel-Rätselspiel für den Browser",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "check:levels": "node tools/check-load.mjs",
    "check:solutions": "node tools/check-solutions.mjs",
    "test:e2e:zuzweit": "node tools/e2e-mehrspieler.mjs",
    "check:levelseiten": "node tools/levelseiten/pruefen.mjs dist"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "fengari-web": "^0.1.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "@types/three": "^0.187.0",
    "fengari": "^0.1.5",
    "ssh2-sftp-client": "^12.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true
}
