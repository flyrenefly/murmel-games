# murmel.games (IONOS Apache): one canonical address https://murmel.games/
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://murmel.games/$1 [R=301,L]

# Long cache for hashed build files, short for everything else.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The service worker is checked on every visit, so a new release reaches installed apps at once.
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType audio/wav "access plus 30 days"
</IfModule>
